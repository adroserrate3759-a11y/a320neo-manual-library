{
  "name": "a320neo-manual-library",
  "version": "1.0.0",
  "private": true,
  "description": "A320 MSFS manual library portable desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.study.a320manual",
    "productName": "A320neo Manual Library",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "A320neo-Manual-Library-Portable-${version}.${ext}"
    }
  }
}