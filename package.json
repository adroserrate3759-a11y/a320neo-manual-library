
{
  "name": "a320neo-manual",
  "version": "1.0.0",
  "description": "A320neo V2 Manual",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.a320neo.manual",
    "productName": "A320neo Manual",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
